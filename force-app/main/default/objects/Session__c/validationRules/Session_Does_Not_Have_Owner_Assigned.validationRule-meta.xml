<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Session_Does_Not_Have_Owner_Assigned</fullName>
    <active>true</active>
    <description>The session does not have an owner associated</description>
    <errorConditionFormula>ISBLANK(Owner__c)</errorConditionFormula>
    <errorDisplayField>Owner__c</errorDisplayField>
