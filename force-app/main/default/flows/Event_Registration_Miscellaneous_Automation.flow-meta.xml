    <decisions>
        <name>Send_Manual_Registration_Alert</name>
        <label>Send Manual Registration Alert</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Is_Event_Order_Active_and_Send_Event_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Send_Manual_Registration</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Is_Invited_Registration_Valid</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ManualRegistration_Alert</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Yes Send Manual Registration</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Is_Invited_Registration_Valid</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK(TEXT({!$Record.Event_Registration_Status__c}))),
ISPICKVAL({!$Record.Event_Registration_Status__c},&apos;Invited&apos;),NOT(ISBLANK({!$Record.Event_Email__c})),
NOT(ISBLANK({!$Record.Event__c})),ISPICKVAL({!$Record.Event_Product__r.Event__r.Manual_Event_Registration_Template__c},&apos;On&apos;),
OR(NOT(ISBLANK({!$Record.Enquirer__c})),NOT(ISBLANK({!$Record.Contact__c}))))</expression>
    </formulas>
    <formulas>
        <name>Is_Registration_Confirmation_Criteria</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  OR(
        ISNEW(),
        ISCHANGED({!$Record.QR_Code_URL__c}),
        ISCHANGED({!$Record.Event_Registration_Status__c} ),
        ISCHANGED({!$Record.Enquirer__c}),
        ISCHANGED({!$Record.Contact__c}),
       ISCHANGED({!$Record.Account_Name__c})
 ),
  {!$Record.Event_Email__c} &lt;&gt; null,
  {!$Record.QR_Code_URL__c} &lt;&gt; null,
  ISPICKVAL({!$Record.Event_Registration_Status__c}, &apos;Registered&apos;),
  NOT(ISBLANK({!$Record.Event__c} )),
  ISPICKVAL({!$Record.Event__r.Event_Registration_Confirmation_Email__c}, &apos;On&apos;),
  OR(
    NOT(ISBLANK({!$Record.Enquirer__c})),
    NOT(ISBLANK({!$Record.Contact__c})),
    NOT(ISBLANK({!$Record.Account_Name__c}))
  )  
)</expression>
    </formulas>
